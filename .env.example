# PlantPilot environment configuration
# Copy this file to .env and fill in your actual NVIDIA API key.
# NEVER commit the .env file.

# Required: Your NVIDIA API key
NVIDIA_API_KEY=your-api-key-here

# Optional: NVIDIA-compatible API endpoint
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# Optional: Model identifier (default: nvidia/nemotron-3.5-super-vl-120b-a12b)
PLANTPILOT_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b

# Optional: Database path (default: data/plantpilot.db)
PLANTPILOT_DATABASE_PATH=data/plantpilot.db

# Optional: Agent limits
PLANTPILOT_MAX_STEPS=8
PLANTPILOT_MAX_TOOL_CALLS=20
PLANTPILOT_MAX_INPUT_SIZE=8000
PLANTPILOT_MAX_OUTPUT_TOKENS=4000

# Optional: API timeout in seconds
PLANTPILOT_API_TIMEOUT_SECONDS=60.0